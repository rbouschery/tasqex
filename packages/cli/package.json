{
  "name": "@tasqex/cli",
  "version": "0.1.1",
  "description": "Command-line interface for the Tasqex REST API",
  "license": "MIT",
  "homepage": "https://github.com/rbouschery/tasqex/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rbouschery/tasqex.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/rbouschery/tasqex/issues"
  },
  "type": "module",
  "bin": {
    "tasqex": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tasqex/api-client": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@tasqex/api-spec": "workspace:*",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}

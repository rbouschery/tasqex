{
  "name": "tasqex",
  "version": "0.1.0",
  "private": true,
  "description": "Collaborative task board for a team, with a realtime Kanban, comments, tags, and a REST and MCP API. Built on Next.js and Supabase.",
  "license": "MIT",
  "homepage": "https://github.com/rbouschery/tasqex#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rbouschery/tasqex.git"
  },
  "bugs": {
    "url": "https://github.com/rbouschery/tasqex/issues"
  },
  "keywords": [
    "tasks",
    "collaboration",
    "kanban",
    "mcp",
    "api",
    "nextjs",
    "supabase"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm build:packages",
    "dev": "next dev",
    "build": "pnpm --filter @tasqex/api-spec build && next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:bootstrap": "tsx scripts/bootstrap-db.ts",
    "db:env": "tsx scripts/sync-supabase-env.ts",
    "env:verify": "tsx scripts/verify-env.ts",
    "db:seed-admin": "tsx scripts/seed.ts",
    "tasqex": "tsx scripts/tasqex.ts",
    "config:check": "tsx scripts/config-check.ts",
    "config:sync": "tsx scripts/config-sync.ts",
    "supabase": "supabase",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build:packages": "pnpm --filter @tasqex/api-spec --filter @tasqex/api-client --filter @tasqex/cli build",
    "test:packages": "pnpm --filter @tasqex/api-spec --filter @tasqex/api-client --filter @tasqex/cli test",
    "openapi:generate": "pnpm --filter @tasqex/api-spec build && tsx scripts/generate-openapi.ts",
    "openapi:check": "pnpm --filter @tasqex/api-spec build && tsx scripts/generate-openapi.ts --check",
    "seed:board-load": "tsx --env-file=.env.local scripts/seed-board-load.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.1",
    "@tasqex/api-spec": "workspace:*",
    "cal-sans": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.57.0",
    "mcp-handler": "^2.3.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
